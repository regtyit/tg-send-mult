{
  "name": "tg-send-mult",
  "version": "0.1.0",
  "description": "Telegram bulk sender (Telethon/MTProto bridge + Node) with multi-account, rate limiting, dedup and Web dashboard",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/data dist/data",
    "build:web": "cd web && npm run build",
    "build:all": "npm run build && npm run build:web",
    "dev:api": "ts-node-dev --respawn --transpile-only src/apps/api/index.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/apps/worker/index.ts",
    "dev:scheduler": "ts-node-dev --respawn --transpile-only src/apps/scheduler/index.ts",
    "start:api": "node dist/apps/api/index.js",
    "start:worker": "node dist/apps/worker/index.js",
    "start:scheduler": "node dist/apps/scheduler/index.js",
    "cli": "ts-node --transpile-only src/apps/cli/index.ts",
    "tg": "ts-node --transpile-only src/apps/cli/index.ts",
    "setup": "ts-node --transpile-only src/apps/cli/setupDoctor.ts",
    "setup:python": "cd python && python3 -m venv .venv && .venv/bin/pip install -U pip && .venv/bin/pip install -r requirements.txt",
    "migrate:message-dedup": "ts-node --transpile-only src/apps/cli/migrateMessageDedupIndex.ts",
    "migrate:contact-phone-index": "ts-node --transpile-only src/apps/cli/migrateContactPhoneIndex.ts",
    "migrate:campaign-contact-dedup": "ts-node --transpile-only src/apps/cli/migrateCampaignContactDedupIndex.ts",
    "seed:qa-dialogs": "NODE_ENV=development ts-node --transpile-only src/seeds/runSeedQaDialogs.ts",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:all",
    "test:python": "bash -c 'cd python && if [ -x .venv/bin/python ]; then .venv/bin/python -m unittest discover -s tests -p \"test_*.py\" -v; else python3 -m unittest discover -s tests -p \"test_*.py\" -v; fi'",
    "test:watch": "vitest",
    "test:all": "vitest run && npm run test:python",
    "check": "npm run typecheck && npm run lint && npm test",
    "mongod:local": "bash scripts/mongod-local.sh",
    "docker:start": "bash docker/start.sh",
    "docker:doctor": "bash docker/doctor.sh",
    "docker:sync-data": "bash docker/sync-local-data.sh",
    "docker:build": "bash docker/ensure-data-dir.sh && bash docker/compose.sh build",
    "docker:up": "bash docker/compose.sh up -d",
    "docker:down": "bash docker/compose.sh down",
    "docker:logs": "bash docker/compose.sh logs -f",
    "docker:ps": "bash docker/compose.sh ps"
  },
  "dependencies": {
    "@bull-board/api": "^6.5.0",
    "@bull-board/fastify": "^6.5.0",
    "@cryptography/aes": "^0.1.1",
    "@fastify/basic-auth": "^6.1.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "bullmq": "^5.34.5",
    "commander": "^12.1.0",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fflate": "^0.8.2",
    "input": "^1.0.1",
    "inquirer": "^9.3.7",
    "ioredis": "^5.4.1",
    "libphonenumber-js": "^1.11.17",
    "mongoose": "^8.9.5",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "socks-proxy-agent": "^8.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
