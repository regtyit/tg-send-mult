# Optional variables for docker compose (copy lines into your `.env` or export before `docker compose up`).
#
# Local MongoDB files (same DB as native `mongod` on this machine):
# MONGO_DATA_DIR=/home/you/var/mongodb/data
#
# Local Valkey snapshot (RDB; same format as Redis). On Artix with valkey package:
#   npm run docker:sync-data
# or manually:
#   mkdir -p docker/valkey-data
#   sudo cp /var/lib/valkey/dump.rdb docker/valkey-data/
#   sudo chown "$USER:$USER" docker/valkey-data/dump.rdb
# VALKEY_DATA_DIR=./docker/valkey-data
#
# Legacy name (still supported in compose):
# REDIS_DATA_DIR=./docker/valkey-data
