# --- Telegram MTProto API credentials (must match the app used to create the session) ---
# Optional fallback Telegram API credentials (my.telegram.org → API development tools).
# Prefer storing api_id + api_hash per sender account (dashboard / POST /api/accounts / CLI --api-id/--api-hash).
# Leave empty if every account has its own telegramApiId / telegramApiHash in MongoDB.
TG_API_ID=
TG_API_HASH=
# Telethon bridge (`python/tg_worker/run.py`). On Arch/Artix (PEP 668) use a venv:
#   npm run setup:python
# If TG_PYTHON is python3/python, the app uses python/.venv/bin/python when that exists.
TG_PYTHON=python3
# Default MTProxy id for CLI Telegram actions (auth/login/import/send-test). Optional.
TELEGRAM_PROXY_ID=
# Or provide raw MTProxy creds; CLI will auto-create/reuse proxy record.
TG_MTPROXY_HOST=
TG_MTPROXY_PORT=
TG_MTPROXY_SECRET=
TG_MTPROXY_COUNTRY=

# --- MongoDB ---
MONGO_URI=mongodb://127.0.0.1:27017/tg_send_mult

# --- Redis (BullMQ) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- HTTP API ---
API_HOST=0.0.0.0
API_PORT=3000
# IMPORTANT: change these before exposing the dashboard. In production the app
# refuses to start if these are left at the dev defaults `admin`/`changeme` or
# if the password is shorter than 12 characters.
API_BASIC_USER=admin
API_BASIC_PASSWORD=changeme
# Comma-separated CORS allowlist. Leave empty for same-origin only (recommended).
# Use "*" only in development to reflect any origin.
CORS_ALLOWED_ORIGINS=

# --- Crypto ---
# 32-byte hex string used to encrypt MTProto session strings in MongoDB.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Do NOT commit a real key here.
SESSION_KEY=replace-with-64-char-hex-from-crypto-randomBytes-32

# --- Operational tunables ---
# How long delivery_events are kept in MongoDB (TTL index). 0 disables the TTL.
DELIVERY_EVENT_TTL_DAYS=90
# Per-action timeout for the Python Telethon bridge (ms). 0 disables.
TG_BRIDGE_TIMEOUT_MS=45000
# Extra buffer (seconds) added to FLOOD_WAIT before retrying.
FLOOD_WAIT_BUFFER_SEC=5

# --- Logging ---
LOG_LEVEL=info
NODE_ENV=development

# --- Anti-limit defaults (per account, can be overridden per-account in DB) ---
DEFAULT_MSGS_PER_DAY=80
DEFAULT_RATE_PER_HOUR=20
DEFAULT_WINDOW_START=09:00
DEFAULT_WINDOW_END=22:00
DEFAULT_TIMEZONE=Europe/Moscow

# --- Default device profile (used for fresh logins) ---
DEFAULT_DEVICE_MODEL=Desktop
DEFAULT_SYSTEM_VERSION=Linux
DEFAULT_APP_VERSION=1.0.0
DEFAULT_LANG_CODE=en
